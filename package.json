{
  "name": "@cosyte/cli",
  "version": "0.1.12",
  "description": "The Cosyte command line for Node.js and TypeScript: one command over HL7 v2, FHIR R4, X12, ASTM, NCPDP, C-CDA, DICOM, and MLLP, with HL7 v2 to FHIR conversion from transform, code mapping from terminology, and the cosyte-mcp MCP server for agents.",
  "keywords": [
    "cli",
    "command-line",
    "healthcare",
    "hl7",
    "hl7v2",
    "fhir",
    "x12",
    "ncpdp",
    "astm",
    "c-cda",
    "dicom",
    "mllp",
    "mcp",
    "interoperability",
    "typescript"
  ],
  "bin": {
    "cosyte": "./dist/bin/cosyte.mjs",
    "cosyte-mcp": "./dist/bin/cosyte-mcp.mjs"
  },
  "homepage": "https://docs.cosyte.com/cli",
  "bugs": {
    "url": "https://github.com/cosyte/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/cli.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.mjs"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "cosyte-phi-scan",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:docs-content": "cosyte-docs-content",
    "check:process": "cosyte-process check",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "fuzz": "vitest run test/property/fuzz.property.test.ts",
    "bench:reading": "cosyte-bench run --suite bench/cli.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/cli.bench.mjs",
    "bench:profile": "node --expose-gc --enable-source-maps bench/profile.mjs dist/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "node scripts/process-tool.mjs tsc -p examples/tsconfig.json",
    "lint:examples": "node scripts/process-tool.mjs eslint examples --max-warnings=0",
    "phi-scan:examples": "cosyte-phi-scan examples/*.ts",
    "clean": "rm -rf dist coverage",
    "vendor:refresh": "bash scripts/vendor-refresh.sh",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && node scripts/sync-version.mjs && cosyte-process format",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.13",
    "@cosyte/synth": "^0.1.5",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@cosyte/hl7": "^0.1.10",
    "@cosyte/terminology": "^0.1.6"
  },
  "optionalDependencies": {
    "@cosyte/astm": "^0.1.7",
    "@cosyte/ccda": "^0.1.6",
    "@cosyte/deid": "^0.2.4",
    "@cosyte/dicom": "^0.1.13",
    "@cosyte/fhir": "^0.1.11",
    "@cosyte/mllp": "^0.1.9",
    "@cosyte/ncpdp": "^0.1.7",
    "@cosyte/transform": "^0.2.2",
    "@cosyte/x12": "^0.1.12",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
